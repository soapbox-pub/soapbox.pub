# Working ngit git server for the soapbox-pub repo (public, read-only).
NGIT_HTTP=https://relay.ngit.dev/npub10qdp2fc9ta6vraczxrcs8prqnv69fru2k6s2dj48gqjcylulmtjsg9arpj/soapbox-pub.git

# GitLab push URL with a Project Access Token (role: Maintainer, scope: write_repository).
# Create at: gitlab.com/soapbox-pub/soapbox.pub -> Settings -> Access tokens.
# Keep this file chmod 600; the token grants push access.
GITLAB_PUSH_URL=https://oauth2:REPLACE_WITH_TOKEN@gitlab.com/soapbox-pub/soapbox.pub.git

# Branch to mirror.
BRANCH=main

# Repo 'd' identifier used in the kind-30618 state events.
REPO_IDENTIFIER=soapbox-pub

# Relays to watch for state events (comma-separated).
RELAYS=wss://relay.ngit.dev,wss://git.shakespeare.diy,wss://relay.ditto.pub,wss://relay.primal.net,wss://relay.nostr.band

# Local bare repo the bot maintains.
WORKDIR=/var/lib/ngit-gitlab-mirror/repo

# Safety-net poll interval (seconds) in case a state event is missed.
POLL_SECONDS=300
