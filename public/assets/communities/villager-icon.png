  <style type="text/tailwindcss">/* fs:/projects/villager/src/index.css */
@tailwind base;
@tailwind components;
@tailwind utilities;
@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 20 14.3% 4.1%;
    --card: 0 0% 100%;
    --card-foreground: 20 14.3% 4.1%;
    --popover: 0 0% 100%;
    --popover-foreground: 20 14.3% 4.1%;
    --primary: 5 78% 70%;
    --primary-foreground: 0 0% 100%;
    --secondary: 177 56% 56%;
    --secondary-foreground: 0 0% 100%;
    --muted: 20 14.3% 95.9%;
    --muted-foreground: 20 9.1% 45.9%;
    --accent: 48 100% 71%;
    --accent-foreground: 20 14.3% 4.1%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 0 0% 98%;
    --border: 20 5.9% 90%;
    --input: 20 5.9% 90%;
    --ring: 5 78% 70%;
    --radius: 1rem;
    --sidebar-background: 0 0% 98%;
    --sidebar-foreground: 20 14.3% 20%;
    --sidebar-primary: 5 78% 70%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 20 14.3% 95.9%;
    --sidebar-accent-foreground: 20 14.3% 20%;
    --sidebar-border: 20 5.9% 90%;
    --sidebar-ring: 5 78% 70%;
  }
  .dark {
    --background: 20 14.3% 4.1%;
    --foreground: 0 0% 95%;
    --card: 20 14.3% 8%;
    --card-foreground: 0 0% 95%;
    --popover: 20 14.3% 8%;
    --popover-foreground: 0 0% 95%;
    --primary: 5 78% 70%;
    --primary-foreground: 20 14.3% 4.1%;
    --secondary: 177 56% 56%;
    --secondary-foreground: 0 0% 100%;
    --muted: 20 14.3% 15%;
    --muted-foreground: 20 9.1% 63.9%;
    --accent: 48 100% 71%;
    --accent-foreground: 20 14.3% 4.1%;
    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 0 0% 98%;
    --border: 20 14.3% 20%;
    --input: 20 14.3% 20%;
    --ring: 5 78% 70%;
    --sidebar-background: 20 14.3% 8%;
    --sidebar-foreground: 0 0% 95%;
    --sidebar-primary: 5 78% 70%;
    --sidebar-primary-foreground: 20 14.3% 4.1%;
    --sidebar-accent: 20 14.3% 15%;
    --sidebar-accent-foreground: 0 0% 95%;
    --sidebar-border: 20 14.3% 20%;
    --sidebar-ring: 5 78% 70%;
  }
}
@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slide-down {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes scale-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
  .animate-slide-down {
    animation: slide-down 0.3s ease-out forwards;
  }
  .animate-scale-in {
    animation: scale-in 0.2s ease-out forwards;
  }
  html {
    scroll-behavior: smooth;
  }
  *:focus-visible {
    @apply outline-none ring-2 ring-primary ring-offset-2 ring-offset-background;
  }
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    @apply bg-transparent;
  }
  ::-webkit-scrollbar-thumb {
    @apply bg-muted rounded-full;
  }
  ::-webkit-scrollbar-thumb:hover {
    @apply bg-muted-foreground/30;
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted)) transparent;
  }
}
@layer utilities {
  @media (max-width: 640px) {
    button,
    a,
    [role=button],
    [role=link] {
      min-height: 2.75rem;
    }
    p,
    li {
      line-height: 1.6;
    }
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    [class*=CardContent] {
      padding: 1rem;
    }
    input,
    select,
    textarea {
      font-size: 16px;
    }
    [role=dialog] {
      max-height: 90vh;
    }
  }
  html,
  body {
    overflow-x: hidden;
    width: 100%;
  }
  * {
    -webkit-overflow-scrolling: touch;
  }
}

